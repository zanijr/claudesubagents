{
    "version": "4.0.0",
    "agentPaths": [".claude/agents/project"],
    "maxRetries": 3,
    "defaultModel": "sonnet",
    "contextManagement": {
        "enabled": true,
        "checkpointDir": ".claude/context/checkpoints",
        "maxContinuations": 5,
        "checkpointIntervalTurns": 20,
        "maxTurns": 80
    },
    "memory": {
        "enabled": true,
        "dir": ".claude/memory",
        "maxLessons": 200,
        "maxFailures": 100
    },
    "selfHealing": {
        "enabled": true,
        "maxRetriesPerSubtask": 3,
        "strategies": ["fix-and-retry", "different-agent", "decompose", "apply-known-fix"],
        "verifyAfterFix": true
    }
}
